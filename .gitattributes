# Harness files are authored here.
*.ps1   text eol=crlf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf

# The published artifact is generated bytes. Preserve it exactly as imported and keep
# it out of diffs and language statistics. This rule is last so it wins over the above.
_site/** -text -diff linguist-generated=true
